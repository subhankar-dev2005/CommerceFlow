# ==============================================================================
# CommerceFlow Production Frontend Configuration Example
# ==============================================================================
# CRITICAL BUILD REQUIREMENT:
# Production builds (npm run build) require a valid public HTTPS API URL.
# Localhost, 127.0.0.1, 0.0.0.0, and loopback endpoints are strictly rejected
# by vite.config.js build validation guards.
#
# SECURITY WARNING:
# NEVER put private credentials, API secrets, or passwords in this file.
# All VITE_ variables are bundled into public client-side JavaScript.
# ==============================================================================

# [REQUIRED] Public Production API Base URL (Must NOT be localhost or loopback)
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# [OPTIONAL] Razorpay Public Key ID (Fallback only; never use RAZORPAY_KEY_SECRET)
VITE_RAZORPAY_KEY_ID=rzp_live_PLACEHOLDER_KEY_ID
