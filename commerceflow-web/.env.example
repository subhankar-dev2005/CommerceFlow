# ==============================================================================
# CommerceFlow Frontend Configuration Template
# ==============================================================================
# NOTE: All variables prefixed with VITE_ are bundled into public client-side
# JavaScript and are exposed to any visitor in the browser.
#
# SECURITY WARNING:
# NEVER place private keys, database credentials, JWT secrets, or payment
# secret keys (such as RAZORPAY_KEY_SECRET) in frontend environment files.
# ==============================================================================

# [REQUIRED] Backend API Base URL
# Local development default: http://localhost:4000/api/v1
# CRITICAL BUILD-TIME REQUIREMENT:
# In production builds (npm run build), VITE_API_BASE_URL is baked directly into the static bundle.
# The build will FAIL if this variable is missing or empty in production.
# It must point to your deployed public backend API URL (e.g., https://example.com/api/v1).
VITE_API_BASE_URL=http://localhost:4000/api/v1


# [OPTIONAL] Razorpay Public Key ID (Fallback only)
# The backend dynamically supplies the authoritative Razorpay public key (keyId)
# in the payment order creation response (POST /api/v1/payments/orders/:orderId).
# This variable is only used as a fallback if the backend response does not include keyId.
# NOTE: Razorpay secret keys (RAZORPAY_KEY_SECRET) are backend-only and must NEVER be added here.
VITE_RAZORPAY_KEY_ID=
