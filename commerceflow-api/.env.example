NODE_ENV=development
PORT=4000

# Allowed CORS origins (comma-separated for multiple origins, e.g. http://localhost:3000,https://app.example.com)
# In production, CORS_ORIGIN must be explicitly configured (wildcard '*' is not allowed).
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=20m

MONGODB_URI=mongodb://localhost:27017/commerceflow

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Reverse proxy trust configuration
# Direct-to-Node deployment (no reverse proxy): TRUST_PROXY=false
# Behind a single reverse proxy (e.g. AWS ALB, Nginx, Cloudflare): TRUST_PROXY=1
# Multiple reverse proxies: configure exact trusted hop count (e.g. 2) or CIDR subnet
# CRITICAL: Do NOT set to 'true' blindly in production unless all upstream hops are trusted.
# Setting this correctly is required for accurate client IP resolution, rate limiting, and X-Forwarded-Proto headers.
TRUST_PROXY=false

# Webhook rate limiting (requests per 15 min)
WEBHOOK_RATE_LIMIT=60
